# ============================================================================
# SolCleanup environment. Copy to .env.local for development; set the same
# variables in your hosting dashboard (e.g. Vercel → Settings → Environment
# Variables) for production. Never commit real values.
# ============================================================================

# --- Public (sent to the browser) -------------------------------------------
# Your live site: canonical URLs, sitemap, link previews. No trailing slash.
# REQUIRED for production builds (the build fails without it).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: Google Search Console "HTML tag" verification code (just the
# content="…" value). Leave empty to omit the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Solana RPC for the browser. Use a Helius key LOCKED TO YOUR DOMAIN
# (Helius dashboard → the key → Access Control → Allowed domains).
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=BROWSER_KEY
# Optional footer links. Leave empty to hide.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Solana RPC for server checks (Portfolio, referral claim verification).
# A separate Helius key WITHOUT a domain lock: the server sends no domain.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=SERVER_KEY
# Supabase project for referrals and rate limits (Project Settings → API Keys).
SUPABASE_URL=https://pzvyklzgrciupnjoftnu.supabase.co
# The SECRET key (sb_secret_… / service_role). Bypasses RLS: server only.
SUPABASE_SECRET_KEY=
# Any long random string; salts the hashed IPs used for rate limiting.
RATE_LIMIT_SALT=
